# Irodion, Luenen. Serverkonfiguration.
# Die Seite liegt in der Wurzel des Repositorys, Hostinger spielt bei jedem
# Push das ganze Repository nach public_html.

# --- HTTPS und Host ---------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Kopfzeilen -------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # Kein Skript in der Seite selbst. Ein <script> mit Code direkt im HTML
  # laeuft lokal, wird hier aber blockiert, das faellt also erst live auf.
  # Deshalb liegt jede Zeile JavaScript in einer Datei unter js/.
  # style-src erlaubt inline, weil jedes Foto seine weichgezeichnete
  # Fassung per style-Attribut traegt. JSON-LD ist unkritisch, es wird
  # nicht ausgefuehrt.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; font-src 'self'; form-action 'none'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>

# --- Kompression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE text/plain text/xml application/xml image/svg+xml
</IfModule>

# --- Cache ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/avif "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
</IfModule>

# Schriften werden per crossorigin geladen und brauchen die Freigabe.
<FilesMatch "\.(woff2)$">
  <IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
  </IfModule>
</FilesMatch>

ErrorDocument 404 /404.html
Options -Indexes

# --- Interne Dateien --------------------------------------------------------
# Werkzeuge, Datenquelle und Notizen liegen mit im Repository und landen
# damit in public_html. Von aussen gibt es sie nicht.
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(scripts|daten)(/|$)
  RedirectMatch 404 \.md$
  RedirectMatch 404 /herkunft\.json$
  RedirectMatch 404 ^/\.git
</IfModule>
